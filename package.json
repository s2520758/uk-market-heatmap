{
  "name": "openalgo-heatmap",
  "version": "0.2.0",
  "description": "Finviz-style market heatmap for React: squarified treemap sized by value, colored by percent change. Includes a UK FTSE market demo and a framework-free core engine.",
  "license": "MIT",
  "author": "Marketcalls (https://openalgo.in)",
  "homepage": "https://openalgo.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marketcalls/openalgo-heatmap.git"
  },
  "bugs": {
    "url": "https://github.com/marketcalls/openalgo-heatmap/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "build:demo": "vite build",
    "dev": "tsup --watch",
    "demo": "vite",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "check": "npm test && npm run typecheck && npm run build && npm run build:demo",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "heatmap",
    "treemap",
    "squarified",
    "finviz",
    "stocks",
    "markets",
    "trading",
    "react",
    "svg",
    "visualization",
    "openalgo",
    "ftse",
    "lse",
    "uk"
  ],
  "publishConfig": {
    "access": "public"
  }
}
